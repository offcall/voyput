{
	"name": "voyput",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "npm run dev -w @voyput/web",
		"build": "npm run build -w @voyput/web",
		"storybook": "npm run storybook -w @voyput/ui",
		"check": "biome check . && tsc --noEmit && vitest run",
		"test": "vitest run",
		"demo:generate": "node --experimental-strip-types scripts/demo/generate.ts && biome format --write apps/web/public/demo",
		"world:outlines": "node --experimental-strip-types scripts/world/outlines.ts",
		"world:generate": "node --experimental-strip-types scripts/world/generate.ts && biome format --write packages/core/src/viz/worldTable.generated.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@resvg/resvg-js": "^2.6.2",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.10",
		"@types/node": "^22.20.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"fake-indexeddb": "^6.2.8",
		"jsdom": "^31.0.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.0.5"
	}
}
