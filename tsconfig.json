{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["node", "vite/client"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [
		"apps/*/src",
		"apps/*/test",
		"apps/*/vite.config.ts",
		"packages/*/src",
		"packages/*/test",
		"packages/*/.storybook",
		"vitest.config.ts",
		"vitest.setup.ts"
	]
}
